{
    "name": "thecodingmachine/tdbm-graphql",
    "description": "A class generator that will generate GraphQL types from your database schema (using thecodingmachine/graphqlite).",
    "license": "MIT",
    "authors": [
        {
            "name": "David Négrier",
            "email": "d.negrier@thecodingmachine.com"
        }
    ],
    "require": {
        "thecodingmachine/tdbm": "^6.0.9",
        "symfony/filesystem": "^6.4",
        "psr/container": "^1",
        "thecodingmachine/graphqlite": "^6.0",
        "thecodingmachine/tdbm-fluid-schema-builder": "^2",
        "doctrine/dbal": "^3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "php-coveralls/php-coveralls": "^2.8",
        "mouf/picotainer": "^1.1",
        "symfony/cache": "^6.4"
    },
    "autoload": {
        "psr-4": {
            "TheCodingMachine\\Tdbm\\GraphQL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheCodingMachine\\Tdbm\\GraphQL\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
